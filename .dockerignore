# Dependencies
node_modules/
.venv/

# Next.js build output
.next/
out/
build/

# Bun / npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo
next-env.d.ts

# Snapshot test output
tests/**/__snapshots__/

# Environment files (never copy secrets into the image)
.env*

# Version control
.git/
.gitignore
.gitattributes

# Editor and OS metadata
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# CI / tooling configs not needed at runtime
.github/
.pre-commit-config*.yaml
bunfig.toml
pyproject.toml

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Makefile
Makefile

# README and docs
README.md
LICENSE
